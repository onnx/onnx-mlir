// CHECK-NOT: separator of consecutive DAGs
// CHECK-DAG:       [[VAR_2_:%.+]] = "onnx.MatMul"([[PARAM_0_]], [[VAR_1_]]) : (tensor<?x?x2xf32>, tensor<2x256xf32>) -> tensor<?x?x256xf32>
// CHECK-DAG:       [[VAR_3_:%.+]] = "onnx.MatMul"([[PARAM_0_]], [[VAR_0_]]) : (tensor<?x?x2xf32>, tensor<2x256xf32>) -> tensor<?x?x256xf32>
// CHECK:           [[VAR_4_:%.+]] = "onnx.Sigmoid"([[VAR_2_]]) : (tensor<?x?x256xf32>) -> tensor<?x?x256xf32>
// CHECK:           [[VAR_5_:%.+]] = "onnx.Mul"([[VAR_2_]], [[VAR_4_]]) : (tensor<?x?x256xf32>, tensor<?x?x256xf32>) -> tensor<?x?x256xf32>
// CHECK:           [[VAR_6_:%.+]] = "onnx.Mul"([[VAR_5_]], [[VAR_3_]]) : (tensor<?x?x256xf32>, tensor<?x?x256xf32>) -> tensor<?x?x256xf32>
// CHECK:           onnx.Return [[VAR_6_]] : tensor<?x?x256xf32>
// CHECK:         }

}

