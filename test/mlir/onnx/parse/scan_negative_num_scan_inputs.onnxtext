// RUN: not onnx-mlir --EmitONNXBasic --printIR %s 2>&1 | FileCheck %s

// Tests that a Scan node with a negative num_scan_inputs is rejected with a
// clear diagnostic. A negative value passes onnx.checker but is converted to
// size_t by ONNX's Scan shape inference, which then reaches an oversized
// allocation and crashes the compiler.

<
ir_version: 8,
opset_import: [ "" : 16 ]
>
agraph (float[2] init, float[3,2] xs) => (float[2] y, float[3,2] ys)
{
    y, ys = Scan <num_scan_inputs = -1, body = scan_body (float[2] s, float[2] x) => (float[2] so, float[2] xo) {
        so = Add (s, x)
        xo = Identity (so)
    }> (init, xs)
}

// CHECK: Scan node has 'num_scan_inputs' = -1, which is outside the range [0, 2] of its input count
