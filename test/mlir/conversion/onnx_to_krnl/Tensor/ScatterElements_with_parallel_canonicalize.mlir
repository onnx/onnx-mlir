// RUN: onnx-mlir-opt --convert-onnx-to-krnl=enable-parallel --canonicalize %s -split-input-file | FileCheck %s

// Parallel coverage for ScatterElements. An update at position p is stored at p
// with p[axis] replaced by its index, so iterations that differ at any level
// other than `axis` store to distinct elements. With reduction "none" the whole
// nest is parallelizable; with a reduction the `axis` level is excluded.

// Static shapes, reduction "none", axis 0: the whole nest is order-independent,
// so the outermost level (trip count 4) is parallel.
func.func @test_parallel_scatter_elements_static(%arg0: tensor<8x64xf32> {onnx.name = "data"}, %arg1: tensor<4x64xf32> {onnx.name = "updates"}) -> (tensor<8x64xf32> {onnx.name = "output"}) {
  %idx = onnx.Constant dense<[[5, 1, 5, 3, 6, 6, 3, 0, 0, 2, 1, 2, 3, 1, 3, 6, 7, 2, 4, 7, 1, 5, 0, 5, 7, 1, 0, 7, 5, 2, 0, 3, 1, 4, 4, 6, 2, 0, 4, 6, 5, 0, 6, 1, 0, 7, 0, 2, 0, 6, 5, 1, 7, 2, 4, 0, 2, 4, 5, 5, 3, 3, 5, 4], [1, 6, 4, 0, 0, 0, 5, 4, 1, 7, 4, 0, 2, 4, 7, 7, 2, 5, 7, 2, 4, 1, 5, 2, 4, 2, 5, 2, 0, 4, 1, 7, 7, 1, 5, 1, 1, 3, 2, 4, 1, 3, 3, 3, 1, 1, 7, 4, 7, 1, 4, 0, 3, 0, 3, 1, 5, 5, 1, 7, 6, 1, 7, 3], [3, 4, 0, 6, 1, 4, 6, 6, 7, 3, 2, 4, 0, 0, 5, 2, 6, 1, 3, 4, 3, 3, 7, 7, 3, 3, 6, 5, 3, 0, 2, 6, 3, 3, 3, 7, 6, 4, 0, 2, 7, 5, 7, 5, 7, 0, 6, 0, 1, 5, 2, 3, 2, 5, 5, 4, 4, 0, 2, 1, 1, 4, 0, 2], [0, 0, 6, 7, 7, 7, 4, 3, 4, 1, 6, 5, 4, 6, 4, 3, 1, 0, 2, 0, 7, 7, 4, 6, 0, 0, 2, 3, 2, 3, 6, 5, 5, 7, 2, 0, 5, 1, 1, 7, 4, 4, 5, 6, 6, 2, 4, 7, 4, 2, 3, 5, 0, 7, 1, 2, 0, 2, 6, 4, 7, 7, 6, 1]]> : tensor<4x64xi64>
  %0 = "onnx.ScatterElements"(%arg0, %idx, %arg1) {axis = 0 : si64} : (tensor<8x64xf32>, tensor<4x64xi64>, tensor<4x64xf32>) -> tensor<8x64xf32>
  return %0 : tensor<8x64xf32>

// CHECK-LABEL:  func.func @test_parallel_scatter_elements_static
// CHECK-SAME:   ([[PARAM_0_:%.+]]: memref<8x64xf32> {onnx.name = "data"}, [[PARAM_1_:%.+]]: memref<4x64xf32> {onnx.name = "updates"}) -> (memref<8x64xf32> {onnx.name = "output"}) {
// CHECK-DAG:       [[CST_0_:%.+]] = arith.constant 0 : index
// CHECK-DAG:       [[CST_512_:%.+]] = arith.constant 512 : i64
// CHECK-DAG:       [[VAR_0_:%.+]] = "krnl.global"() <{name = "constant_{{[0-9]+}}", shape = [4, 64], value = dense<""> : tensor<4x64xi64>}> : () -> memref<4x64xi64>
// CHECK-DAG:       [[RES_:%.+]] = memref.alloc() alignment = 16 : memref<8x64xf32>
// CHECK:           "krnl.memcpy"([[RES_]], [[PARAM_0_]], [[CST_512_]], [[CST_0_]], [[CST_0_]]) : (memref<8x64xf32>, memref<8x64xf32>, i64, index, index) -> ()
// CHECK:           [[LOOP_0_:%.+]]:2 = krnl.define_loops 2
// CHECK:           krnl.parallel([[LOOP_0_]]#0) : !krnl.loop
// CHECK:           krnl.iterate([[LOOP_0_]]#0, [[LOOP_0_]]#1) with ([[LOOP_0_]]#0 -> [[I_0_:%.+]] = 0 to 4, [[LOOP_0_]]#1 -> [[I_1_:%.+]] = 0 to 64){
// CHECK:             [[VAR_2_:%.+]]:2 = krnl.get_induction_var_value([[LOOP_0_]]#0, [[LOOP_0_]]#1) : (!krnl.loop, !krnl.loop) -> (index, index)
// CHECK-DAG:         [[LOAD_PARAM_1_MEM_:%.+]] = krnl.load [[PARAM_1_]]{{.}}[[VAR_2_]]#0, [[VAR_2_]]#1] : memref<4x64xf32>
// CHECK-DAG:         [[LOAD_VAR_0_MEM_:%.+]] = krnl.load [[VAR_0_]]{{.}}[[VAR_2_]]#0, [[VAR_2_]]#1] : memref<4x64xi64>
// CHECK:             [[VAR_5_:%.+]] = arith.index_cast [[LOAD_VAR_0_MEM_]] : i64 to index
// CHECK:             krnl.store [[LOAD_PARAM_1_MEM_]], [[RES_]]{{.}}[[VAR_5_]], [[VAR_2_]]#1] : memref<8x64xf32>
// CHECK:           }
// CHECK:           return [[RES_]] : memref<8x64xf32>
// CHECK:         }

}

// -----

// reduction "add" with duplicate indices along axis 0: level 0 is excluded and
// stays sequential inside each parallel iteration of level 1.
func.func @test_parallel_scatter_elements_add_axis0(%arg0: tensor<8x64xf32> {onnx.name = "data"}, %arg1: tensor<6x64xf32> {onnx.name = "updates"}) -> (tensor<8x64xf32> {onnx.name = "output"}) {
  %idx = onnx.Constant dense<[[5, 1, 7, 6, 1, 2, 7, 1, 4, 6, 2, 2, 5, 4, 7, 3, 1, 6, 5, 1, 6, 5, 7, 1, 0, 6, 0, 1, 1, 2, 0, 4, 4, 3, 4, 6, 4, 4, 2, 5, 5, 7, 4, 0, 6, 0, 0, 7, 0, 4, 7, 0, 4, 4, 7, 1, 7, 1, 1, 0, 4, 1, 1, 1], [5, 1, 7, 6, 1, 2, 7, 1, 4, 6, 2, 2, 5, 4, 7, 3, 1, 6, 5, 1, 6, 5, 7, 1, 0, 6, 0, 1, 1, 2, 0, 4, 4, 3, 4, 6, 4, 4, 2, 5, 5, 7, 4, 0, 6, 0, 0, 7, 0, 4, 7, 0, 4, 4, 7, 1, 7, 1, 1, 0, 4, 1, 1, 1], [5, 7, 7, 7, 7, 0, 2, 6, 4, 0, 0, 2, 1, 1, 3, 3, 7, 3, 4, 7, 5, 5, 6, 1, 4, 7, 6, 1, 0, 3, 3, 2, 0, 1, 3, 0, 2, 4, 7, 3, 0, 3, 2, 4, 7, 2, 2, 0, 1, 4, 6, 1, 0, 3, 7, 0, 6, 4, 3, 0, 6, 0, 0, 6], [5, 3, 5, 2, 6, 2, 2, 3, 3, 5, 7, 7, 0, 7, 4, 7, 5, 4, 2, 2, 6, 0, 5, 1, 2, 5, 1, 3, 5, 1, 4, 4, 0, 6, 5, 2, 0, 0, 0, 0, 5, 3, 6, 3, 2, 0, 5, 3, 1, 3, 1, 2, 7, 7, 1, 4, 3, 5, 7, 7, 5, 5, 4, 1], [1, 5, 1, 6, 1, 7, 0, 3, 5, 7, 2, 1, 3, 0, 7, 2, 1, 1, 7, 3, 3, 5, 4, 4, 6, 1, 4, 1, 6, 2, 4, 5, 3, 7, 3, 0, 1, 7, 4, 4, 6, 0, 0, 1, 4, 3, 1, 7, 1, 3, 7, 5, 0, 4, 3, 7, 3, 2, 7, 7, 6, 5, 4, 5], [3, 3, 1, 5, 2, 2, 0, 0, 4, 6, 0, 0, 3, 1, 7, 6, 3, 2, 3, 2, 5, 7, 1, 4, 4, 4, 0, 4, 4, 4, 3, 0, 7, 6, 2, 1, 6, 2, 5, 3, 1, 1, 6, 2, 2, 1, 6, 4, 7, 3, 4, 4, 7, 4, 4, 1, 1, 4, 6, 6, 5, 6, 5, 6]]> : tensor<6x64xi64>
  %0 = "onnx.ScatterElements"(%arg0, %idx, %arg1) {axis = 0 : si64, reduction = "add"} : (tensor<8x64xf32>, tensor<6x64xi64>, tensor<6x64xf32>) -> tensor<8x64xf32>
  return %0 : tensor<8x64xf32>

// CHECK-LABEL:  func.func @test_parallel_scatter_elements_add_axis0
// CHECK-SAME:   ([[PARAM_0_:%.+]]: memref<8x64xf32> {onnx.name = "data"}, [[PARAM_1_:%.+]]: memref<6x64xf32> {onnx.name = "updates"}) -> (memref<8x64xf32> {onnx.name = "output"}) {
// CHECK-DAG:       [[CST_0_:%.+]] = arith.constant 0 : index
// CHECK-DAG:       [[CST_512_:%.+]] = arith.constant 512 : i64
// CHECK-DAG:       [[VAR_0_:%.+]] = "krnl.global"() <{name = "constant_{{[0-9]+}}", shape = [6, 64], value = dense<""> : tensor<6x64xi64>}> : () -> memref<6x64xi64>
// CHECK-DAG:       [[RES_:%.+]] = memref.alloc() alignment = 16 : memref<8x64xf32>
// CHECK:           "krnl.memcpy"([[RES_]], [[PARAM_0_]], [[CST_512_]], [[CST_0_]], [[CST_0_]]) : (memref<8x64xf32>, memref<8x64xf32>, i64, index, index) -> ()
// CHECK:           [[LOOP_0_:%.+]]:2 = krnl.define_loops 2
// CHECK:           krnl.parallel([[LOOP_0_]]#1) : !krnl.loop
// CHECK:           krnl.iterate([[LOOP_0_]]#0, [[LOOP_0_]]#1) with ([[LOOP_0_]]#0 -> [[I_0_:%.+]] = 0 to 6, [[LOOP_0_]]#1 -> [[I_1_:%.+]] = 0 to 64){
// CHECK:             [[VAR_2_:%.+]]:2 = krnl.get_induction_var_value([[LOOP_0_]]#0, [[LOOP_0_]]#1) : (!krnl.loop, !krnl.loop) -> (index, index)
// CHECK-DAG:         [[LOAD_PARAM_1_MEM_:%.+]] = krnl.load [[PARAM_1_]]{{.}}[[VAR_2_]]#0, [[VAR_2_]]#1] : memref<6x64xf32>
// CHECK-DAG:         [[LOAD_VAR_0_MEM_:%.+]] = krnl.load [[VAR_0_]]{{.}}[[VAR_2_]]#0, [[VAR_2_]]#1] : memref<6x64xi64>
// CHECK:             [[VAR_5_:%.+]] = arith.index_cast [[LOAD_VAR_0_MEM_]] : i64 to index
// CHECK:             [[LOAD_RES_MEM_:%.+]] = krnl.load [[RES_]]{{.}}[[VAR_5_]], [[VAR_2_]]#1] : memref<8x64xf32>
// CHECK:             [[VAR_7_:%.+]] = arith.addf [[LOAD_RES_MEM_]], [[LOAD_PARAM_1_MEM_]] : f32
// CHECK:             krnl.store [[VAR_7_]], [[RES_]]{{.}}[[VAR_5_]], [[VAR_2_]]#1] : memref<8x64xf32>
// CHECK:           }
// CHECK:           return [[RES_]] : memref<8x64xf32>
// CHECK:         }

}

