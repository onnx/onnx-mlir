// reduction "add" with duplicate indices along axis 1: level 1 is excluded and
// level 0 is parallel.
func.func @test_parallel_scatter_elements_add_axis1(%arg0: tensor<64x8xf32> {onnx.name = "data"}, %arg1: tensor<64x6xf32> {onnx.name = "updates"}) -> (tensor<64x8xf32> {onnx.name = "output"}) {
  %idx = onnx.Constant dense<[[4, 4, 4, 1, 0, 4], [2, 2, 4, 6, 5, 3], [5, 5, 0, 6, 3, 1], [0, 0, 7, 2, 4, 7], [0, 0, 2, 7, 6, 5], [4, 4, 4, 4, 6, 3], [4, 4, 6, 1, 2, 2], [1, 1, 7, 3, 7, 5], [7, 7, 2, 3, 3, 1], [2, 2, 1, 5, 3, 5], [4, 4, 0, 6, 6, 6], [3, 3, 4, 5, 0, 7], [4, 4, 2, 3, 1, 4], [3, 3, 6, 7, 6, 4], [0, 0, 0, 6, 7, 7], [0, 0, 6, 7, 7, 3], [1, 1, 2, 2, 1, 7], [1, 1, 0, 2, 3, 0], [4, 4, 4, 6, 1, 1], [1, 1, 3, 6, 4, 3], [0, 0, 4, 7, 4, 5], [3, 3, 3, 3, 0, 6], [4, 4, 0, 3, 7, 6], [1, 1, 3, 6, 5, 3], [7, 7, 5, 6, 5, 6], [3, 3, 4, 1, 3, 7], [3, 3, 3, 3, 7, 3], [4, 4, 1, 7, 2, 3], [7, 7, 0, 2, 6, 0], [3, 3, 2, 6, 0, 0], [2, 2, 7, 5, 1, 1], [2, 2, 3, 2, 7, 0], [4, 4, 5, 5, 7, 2], [1, 1, 1, 4, 1, 5], [6, 6, 3, 6, 5, 4], [6, 6, 0, 7, 3, 5], [7, 7, 5, 5, 7, 0], [6, 6, 6, 0, 6, 0], [7, 7, 0, 4, 3, 1], [5, 5, 4, 5, 0, 4], [5, 5, 4, 0, 1, 0], [3, 3, 7, 7, 6, 4], [6, 6, 2, 7, 2, 0], [4, 4, 3, 5, 5, 7], [5, 5, 3, 6, 2, 3], [6, 6, 0, 7, 5, 2], [6, 6, 1, 4, 1, 3], [1, 1, 7, 7, 2, 3], [2, 2, 7, 3, 1, 4], [4, 4, 4, 5, 4, 4], [3, 3, 3, 2, 3, 3], [2, 2, 3, 5, 1, 6], [4, 4, 3, 1, 7, 0], [1, 1, 7, 3, 7, 5], [0, 0, 3, 1, 0, 3], [3, 3, 5, 2, 7, 4], [0, 0, 5, 3, 0, 5], [5, 5, 0, 3, 4, 0], [3, 3, 5, 6, 5, 2], [4, 4, 3, 0, 7, 7], [1, 1, 1, 6, 2, 1], [2, 2, 4, 6, 4, 4], [6, 6, 4, 5, 6, 6], [0, 0, 3, 6, 6, 3]]> : tensor<64x6xi64>
  %0 = "onnx.ScatterElements"(%arg0, %idx, %arg1) {axis = 1 : si64, reduction = "add"} : (tensor<64x8xf32>, tensor<64x6xi64>, tensor<64x6xf32>) -> tensor<64x8xf32>
  return %0 : tensor<64x8xf32>

// CHECK-LABEL:  func.func @test_parallel_scatter_elements_add_axis1
// CHECK-SAME:   ([[PARAM_0_:%.+]]: memref<64x8xf32> {onnx.name = "data"}, [[PARAM_1_:%.+]]: memref<64x6xf32> {onnx.name = "updates"}) -> (memref<64x8xf32> {onnx.name = "output"}) {
// CHECK-DAG:       [[CST_0_:%.+]] = arith.constant 0 : index
// CHECK-DAG:       [[CST_512_:%.+]] = arith.constant 512 : i64
// CHECK-DAG:       [[VAR_0_:%.+]] = "krnl.global"() <{name = "constant_{{[0-9]+}}", shape = [64, 6], value = dense<""> : tensor<64x6xi64>}> : () -> memref<64x6xi64>
// CHECK-DAG:       [[RES_:%.+]] = memref.alloc() alignment = 16 : memref<64x8xf32>
// CHECK:           "krnl.memcpy"([[RES_]], [[PARAM_0_]], [[CST_512_]], [[CST_0_]], [[CST_0_]]) : (memref<64x8xf32>, memref<64x8xf32>, i64, index, index) -> ()
// CHECK:           [[LOOP_0_:%.+]]:2 = krnl.define_loops 2
// CHECK:           krnl.parallel([[LOOP_0_]]#0) : !krnl.loop
// CHECK:           krnl.iterate([[LOOP_0_]]#0, [[LOOP_0_]]#1) with ([[LOOP_0_]]#0 -> [[I_0_:%.+]] = 0 to 64, [[LOOP_0_]]#1 -> [[I_1_:%.+]] = 0 to 6){
// CHECK:             [[VAR_2_:%.+]]:2 = krnl.get_induction_var_value([[LOOP_0_]]#0, [[LOOP_0_]]#1) : (!krnl.loop, !krnl.loop) -> (index, index)
// CHECK-DAG:         [[LOAD_PARAM_1_MEM_:%.+]] = krnl.load [[PARAM_1_]]{{.}}[[VAR_2_]]#0, [[VAR_2_]]#1] : memref<64x6xf32>
// CHECK-DAG:         [[LOAD_VAR_0_MEM_:%.+]] = krnl.load [[VAR_0_]]{{.}}[[VAR_2_]]#0, [[VAR_2_]]#1] : memref<64x6xi64>
// CHECK:             [[VAR_5_:%.+]] = arith.index_cast [[LOAD_VAR_0_MEM_]] : i64 to index
// CHECK:             [[LOAD_RES_MEM_:%.+]] = krnl.load [[RES_]]{{.}}[[VAR_2_]]#0, [[VAR_5_]]{{.}} : memref<64x8xf32>
// CHECK:             [[VAR_7_:%.+]] = arith.addf [[LOAD_RES_MEM_]], [[LOAD_PARAM_1_MEM_]] : f32
// CHECK:             krnl.store [[VAR_7_]], [[RES_]]{{.}}[[VAR_2_]]#0, [[VAR_5_]]{{.}} : memref<64x8xf32>
// CHECK:           }
// CHECK:           return [[RES_]] : memref<64x8xf32>
// CHECK:         }

}

// -----

// Mixed static and dynamic shapes: `data` is wider than `updates` along the
// dynamic dim.
func.func @test_parallel_scatter_elements_mixed(%arg0: tensor<8x?xf32> {onnx.name = "data"}, %arg1: tensor<4x16xf32> {onnx.name = "updates"}) -> (tensor<8x?xf32> {onnx.name = "output"}) {
  %idx = onnx.Constant dense<[[0, 1, 5, 0, 6, 5, 2, 2, 7, 2, 5, 1, 3, 3, 3, 2], [3, 6, 3, 7, 0, 7, 7, 0, 6, 6, 0, 5, 4, 6, 0, 3], [1, 0, 1, 4, 4, 4, 6, 6, 1, 0, 4, 4, 7, 7, 7, 7], [6, 3, 7, 1, 5, 1, 1, 3, 2, 3, 3, 7, 6, 1, 4, 0]]> : tensor<4x16xi64>
  %0 = "onnx.ScatterElements"(%arg0, %idx, %arg1) {axis = 0 : si64} : (tensor<8x?xf32>, tensor<4x16xi64>, tensor<4x16xf32>) -> tensor<8x?xf32>
  return %0 : tensor<8x?xf32>

// CHECK-DAG:   [[MAP_0_:#.+]] = affine_map<()[s0] -> (s0 * 8)>
// CHECK-DAG:   [[MAP_1_:#.+]] = affine_map<(d0) -> ((d0 * 8) ceildiv 262144)>
// CHECK-DAG:   [[MAP_2_:#.+]] = affine_map<(d0) -> (d0 * 262144)>
// CHECK-DAG:   [[MAP_3_:#.+]] = affine_map<(d0)[s0] -> (d0 * -262144 + s0 * 8, 262144)>
// CHECK-LABEL:  func.func @test_parallel_scatter_elements_mixed
// CHECK-SAME:   ([[PARAM_0_:%.+]]: memref<8x?xf32> {onnx.name = "data"}, [[PARAM_1_:%.+]]: memref<4x16xf32> {onnx.name = "updates"}) -> (memref<8x?xf32> {onnx.name = "output"}) {
// CHECK-DAG:       [[CST_0_:%.+]] = arith.constant 0 : index
// CHECK-DAG:       [[CST_2097152_:%.+]] = arith.constant 2097152 : index
// CHECK-DAG:       [[CST_8_:%.+]] = arith.constant 8 : i64
// CHECK-DAG:       [[CST_1_:%.+]] = arith.constant 1 : index
// CHECK-DAG:       [[VAR_0_:%.+]] = "krnl.global"() <{name = "constant_{{[0-9]+}}", shape = [4, 16], value = dense<{{.}}[0, 1, 5, 0, 6, 5, 2, 2, 7, 2, 5, 1, 3, 3, 3, 2], [3, 6, 3, 7, 0, 7, 7, 0, 6, 6, 0, 5, 4, 6, 0, 3], [1, 0, 1, 4, 4, 4, 6, 6, 1, 0, 4, 4, 7, 7, 7, 7], [6, 3, 7, 1, 5, 1, 1, 3, 2, 3, 3, 7, 6, 1, 4, 0]{{.}}> : tensor<4x16xi64>}> : () -> memref<4x16xi64>
// CHECK:           [[VAR_dim_:%.+]] = memref.dim [[PARAM_0_]], [[CST_1_]] : memref<8x?xf32>
// CHECK-DAG:       [[RES_:%.+]] = memref.alloc([[VAR_dim_]]) alignment = 16 : memref<8x?xf32>
// CHECK-DAG:       [[VAR_dim_0_:%.+]] = memref.dim [[PARAM_0_]], [[CST_1_]] : memref<8x?xf32>
// CHECK:           [[VAR_1_:%.+]] = arith.index_cast [[VAR_dim_0_]] : index to i64
// CHECK-DAG:       [[VAR_2_:%.+]] = arith.muli [[VAR_1_]], [[CST_8_]] : i64
// CHECK-DAG:       [[VAR_3_:%.+]] = affine.apply [[MAP_0_]](){{.}}[[VAR_dim_]]{{.}}
// CHECK:           [[VAR_4_:%.+]] = arith.cmpi sge, [[VAR_3_]], [[CST_2097152_]] : index
// CHECK:           scf.if [[VAR_4_]] {
// CHECK:             [[LOOP_0_:%.+]] = krnl.define_loops 1
// CHECK:             krnl.parallel([[LOOP_0_]]) : !krnl.loop
// CHECK:             krnl.iterate([[LOOP_0_]]) with ([[LOOP_0_]] -> [[I_0_:%.+]] = 0 to [[MAP_1_]]([[VAR_dim_]])){
// CHECK:               [[VAR_7_:%.+]] = krnl.get_induction_var_value([[LOOP_0_]]) : (!krnl.loop) -> index
// CHECK-DAG:           [[VAR_8_:%.+]] = affine.apply [[MAP_2_]]([[VAR_7_]])
// CHECK-DAG:           [[VAR_9_:%.+]] = affine.min [[MAP_3_]]([[VAR_7_]]){{.}}[[VAR_dim_]]{{.}}
// CHECK:               [[VAR_10_:%.+]] = arith.index_cast [[VAR_9_]] : index to i64
// CHECK:               "krnl.memcpy"([[RES_]], [[PARAM_0_]], [[VAR_10_]], [[VAR_8_]], [[VAR_8_]]) : (memref<8x?xf32>, memref<8x?xf32>, i64, index, index) -> ()
// CHECK:             }
// CHECK:           } else {
// CHECK:             "krnl.memcpy"([[RES_]], [[PARAM_0_]], [[VAR_2_]], [[CST_0_]], [[CST_0_]]) : (memref<8x?xf32>, memref<8x?xf32>, i64, index, index) -> ()
// CHECK:           }
// CHECK:           [[LOOP_1_:%.+]]:2 = krnl.define_loops 2
// CHECK:           krnl.parallel([[LOOP_1_]]#0) : !krnl.loop
// CHECK:           krnl.iterate([[LOOP_1_]]#0, [[LOOP_1_]]#1) with ([[LOOP_1_]]#0 -> [[I_1_:%.+]] = 0 to 4, [[LOOP_1_]]#1 -> [[I_2_:%.+]] = 0 to 16){
// CHECK:             [[LOOP_0_:%.+]]:2 = krnl.get_induction_var_value([[LOOP_1_]]#0, [[LOOP_1_]]#1) : (!krnl.loop, !krnl.loop) -> (index, index)
// CHECK-DAG:         [[VAR_7_1_:%.+]] = krnl.load [[PARAM_1_]]{{.}}[[LOOP_0_]]#0, [[LOOP_0_]]#1] : memref<4x16xf32>
// CHECK-DAG:         [[VAR_8_1_:%.+]] = krnl.load [[VAR_0_]]{{.}}[[LOOP_0_]]#0, [[LOOP_0_]]#1] : memref<4x16xi64>
// CHECK:             [[VAR_9_1_:%.+]] = arith.index_cast [[VAR_8_1_]] : i64 to index
// CHECK:             krnl.store [[VAR_7_1_]], [[RES_]]{{.}}[[VAR_9_1_]], [[LOOP_0_]]#1] : memref<8x?xf32>
// CHECK:           }
// CHECK:           return [[RES_]] : memref<8x?xf32>
// CHECK:         }

}

// -----

// All `data` dims dynamic, including a degenerate 1 along the non-axis dim.
func.func @test_parallel_scatter_elements_dynamic(%arg0: tensor<?x?xf32> {onnx.name = "data"}, %arg1: tensor<4x1xf32> {onnx.name = "updates"}) -> (tensor<?x?xf32> {onnx.name = "output"}) {
  %idx = onnx.Constant dense<[[2], [1], [5], [6]]> : tensor<4x1xi64>
  %0 = "onnx.ScatterElements"(%arg0, %idx, %arg1) {axis = 0 : si64} : (tensor<?x?xf32>, tensor<4x1xi64>, tensor<4x1xf32>) -> tensor<?x?xf32>
  return %0 : tensor<?x?xf32>

// CHECK-DAG:   [[MAP_0_:#.+]] = affine_map<(d0) -> (d0 * 262144)>
// CHECK-DAG:   [[MAP_1_:#.+]] = affine_map<(d0)[s0] -> (d0 * -262144 + s0, 262144)>
// CHECK-LABEL:  func.func @test_parallel_scatter_elements_dynamic
// CHECK-SAME:   ([[PARAM_0_:%.+]]: memref<?x?xf32> {onnx.name = "data"}, [[PARAM_1_:%.+]]: memref<4x1xf32> {onnx.name = "updates"}) -> (memref<?x?xf32> {onnx.name = "output"}) {
// CHECK-DAG:       [[CST_2097152_:%.+]] = arith.constant 2097152 : index
// CHECK-DAG:       [[CST_262144_:%.+]] = arith.constant 262144 : index
// CHECK-DAG:       [[CST_1_:%.+]] = arith.constant 1 : index
// CHECK-DAG:       [[CST_0_:%.+]] = arith.constant 0 : index
