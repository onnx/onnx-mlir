// Negative indices count from the back and are normalized inside the parallel
// body.
func.func @test_parallel_scatter_elements_negative(%arg0: tensor<10x24xf32> {onnx.name = "data"}, %arg1: tensor<6x24xf32> {onnx.name = "updates"}) -> (tensor<10x24xf32> {onnx.name = "output"}) {
  %idx = onnx.Constant dense<[[-10, 6, 9, -3, 9, 7, -8, 8, 1, -8, 3, 1, -6, 3, 3, -5, 8, 8, -5, 5, 9, -6, 2, 0], [8, 7, -7, 8, 7, -8, 5, 9, -5, 0, 2, -5, 7, 4, -8, 6, 0, -9, 4, 9, -10, 5, 4, -8], [9, -6, 6, 9, -2, 9, 6, -10, 9, 1, -3, 4, 2, -1, 6, 2, -5, 4, 6, -9, 4, 0, -4, 7], [-5, 5, 8, -9, 1, 3, -1, 7, 0, -6, 8, 9, -2, 2, 1, -2, 6, 7, -8, 3, 6, -2, 3, 1], [2, 3, -5, 0, 3, -10, 0, 5, -6, 5, 1, -8, 9, 6, -5, 7, 3, -5, 8, 7, -3, 7, 8, -6], [7, -8, 2, 5, -6, 5, 3, -9, 3, 8, -5, 7, 3, -10, 8, 0, -6, 3, 1, -2, 2, 1, -1, 9]]> : tensor<6x24xi64>
  %0 = "onnx.ScatterElements"(%arg0, %idx, %arg1) {axis = 0 : si64} : (tensor<10x24xf32>, tensor<6x24xi64>, tensor<6x24xf32>) -> tensor<10x24xf32>
  return %0 : tensor<10x24xf32>

// CHECK-LABEL:  func.func @test_parallel_scatter_elements_negative
// CHECK-SAME:   ([[PARAM_0_:%.+]]: memref<10x24xf32> {onnx.name = "data"}, [[PARAM_1_:%.+]]: memref<6x24xf32> {onnx.name = "updates"}) -> (memref<10x24xf32> {onnx.name = "output"}) {
// CHECK-DAG:       [[CST_0_:%.+]] = arith.constant 0 : index
// CHECK-DAG:       [[CST_240_:%.+]] = arith.constant 240 : i64
// CHECK-DAG:       [[CST_10_:%.+]] = arith.constant 10 : index
// CHECK-DAG:       [[VAR_0_:%.+]] = "krnl.global"() <{name = "constant_{{[0-9]+}}", shape = [6, 24], value = dense<""> : tensor<6x24xi64>}> : () -> memref<6x24xi64>
// CHECK-DAG:       [[RES_:%.+]] = memref.alloc() alignment = 16 : memref<10x24xf32>
// CHECK:           "krnl.memcpy"([[RES_]], [[PARAM_0_]], [[CST_240_]], [[CST_0_]], [[CST_0_]]) : (memref<10x24xf32>, memref<10x24xf32>, i64, index, index) -> ()
// CHECK:           [[LOOP_0_:%.+]]:2 = krnl.define_loops 2
// CHECK:           krnl.parallel([[LOOP_0_]]#0) : !krnl.loop
// CHECK:           krnl.iterate([[LOOP_0_]]#0, [[LOOP_0_]]#1) with ([[LOOP_0_]]#0 -> [[I_0_:%.+]] = 0 to 6, [[LOOP_0_]]#1 -> [[I_1_:%.+]] = 0 to 24){
// CHECK:             [[VAR_2_:%.+]]:2 = krnl.get_induction_var_value([[LOOP_0_]]#0, [[LOOP_0_]]#1) : (!krnl.loop, !krnl.loop) -> (index, index)
// CHECK-DAG:         [[LOAD_PARAM_1_MEM_:%.+]] = krnl.load [[PARAM_1_]]{{.}}[[VAR_2_]]#0, [[VAR_2_]]#1] : memref<6x24xf32>
// CHECK-DAG:         [[LOAD_VAR_0_MEM_:%.+]] = krnl.load [[VAR_0_]]{{.}}[[VAR_2_]]#0, [[VAR_2_]]#1] : memref<6x24xi64>
// CHECK:             [[VAR_5_:%.+]] = arith.index_cast [[LOAD_VAR_0_MEM_]] : i64 to index
// CHECK-DAG:         [[VAR_6_:%.+]] = arith.cmpi slt, [[VAR_5_]], [[CST_0_]] : index
// CHECK-DAG:         [[VAR_7_:%.+]] = arith.addi [[VAR_5_]], [[CST_10_]] : index
// CHECK:             [[VAR_8_:%.+]] = arith.select [[VAR_6_]], [[VAR_7_]], [[VAR_5_]] : index
// CHECK:             krnl.store [[LOAD_PARAM_1_MEM_]], [[RES_]]{{.}}[[VAR_8_]], [[VAR_2_]]#1] : memref<10x24xf32>
// CHECK:           }
// CHECK:           return [[RES_]] : memref<10x24xf32>
// CHECK:         }

}

