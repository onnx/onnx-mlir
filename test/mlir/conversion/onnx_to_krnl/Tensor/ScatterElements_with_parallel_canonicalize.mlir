// CHECK-DAG:           [[VAR_10_:%.+]] = affine.apply [[MAP_0_]]([[VAR_9_]])
// CHECK-DAG:           [[VAR_11_:%.+]] = affine.min [[MAP_1_]]([[VAR_9_]]){{.}}[[VAR_4_]]{{.}}
// CHECK:               [[VAR_12_:%.+]] = arith.index_cast [[VAR_11_]] : index to i64
// CHECK:               "krnl.memcpy"([[RES_]], [[PARAM_0_]], [[VAR_12_]], [[VAR_10_]], [[VAR_10_]]) : (memref<?x?xf32>, memref<?x?xf32>, i64, index, index) -> ()
// CHECK:             }
// CHECK:           } else {
// CHECK:             "krnl.memcpy"([[RES_]], [[PARAM_0_]], [[VAR_3_]], [[CST_0_]], [[CST_0_]]) : (memref<?x?xf32>, memref<?x?xf32>, i64, index, index) -> ()
// CHECK:           }
// CHECK:           [[LOOP_1_:%.+]]:2 = krnl.define_loops 2
// CHECK:           krnl.parallel([[LOOP_1_]]#0) : !krnl.loop
// CHECK:           krnl.iterate([[LOOP_1_]]#0, [[LOOP_1_]]#1) with ([[LOOP_1_]]#0 -> [[I_1_:%.+]] = 0 to 4, [[LOOP_1_]]#1 -> [[I_2_:%.+]] = 0 to 1){
