// CHECK:           scf.if [[VAR_6_]] {
// CHECK:             [[LOOP_0_:%.+]] = krnl.define_loops 1
// CHECK:             krnl.parallel([[LOOP_0_]]) : !krnl.loop
// CHECK:             krnl.iterate([[LOOP_0_]]) with ([[LOOP_0_]] -> [[I_0_:%.+]] = 0 to [[VAR_5_]]){
